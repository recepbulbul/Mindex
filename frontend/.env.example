# Copy to .env.development.local (git-ignored): Vite lets it override .env.development
# (a plain .env.local would not, .env.[mode] wins over it).

# true: MSW mock API in the browser (prototype, GitHub Pages).
# false: the real FastAPI backend; the dev server proxies /api to VITE_API_PROXY.
VITE_USE_MOCKS=false

# Where `npm run dev` forwards /api (backend: `uv run mindex serve`).
VITE_API_PROXY=http://127.0.0.1:8000

# Only when the API is on another origin without the proxy (needs CORS on the backend).
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
